{
  "manifestVersion": 5,
  "id": "com.nixo.tweetbuilder",
  "name": "Tweet Builder",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "25.0.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "tweetBuilderPanel",
      "label": { "default": "Tweet Builder" },
      "minimumSize": { "width": 260, "height": 400 },
      "maximumSize": { "width": 2000, "height": 4000 },
      "preferredDockedSize": { "width": 300, "height": 720 },
      "preferredFloatingSize": { "width": 320, "height": 760 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel.png", "scale": [1, 2], "theme": ["all"] }
      ]
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["https://api.fxtwitter.com", "https://unavatar.io", "https://pbs.twimg.com"]
    },
    "localFileSystem": "request"
  },
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ]
}
